# ===========================================================================
# Exemple de configuration d'environnement — Smart Campus backend
# Copier ce fichier en `.env` puis adapter les valeurs.
# Ne JAMAIS committer le vrai `.env` (voir .gitignore).
# ===========================================================================

# --- Django ---------------------------------------------------------------
# Clé secrète Django. En production : générer une valeur aléatoire longue.
DJANGO_SECRET_KEY=COUmMJ_pNZkDMf46QKRxG7QN48lwq_xPSrrWp_TRzuw_
DJANGO_DEBUG=True
# Hôtes autorisés, séparés par des virgules
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Base de données ------------------------------------------------------
# Format URL django-environ. Par défaut (variable absente) : SQLite local,
# pratique pour développer/tester sans PostgreSQL.
# Exemple PostgreSQL (utilisé par docker-compose) :
DATABASE_URL=postgres://smartcampus:smartcampus@db:5432/smartcampus

# --- Chiffrement des données personnelles (AES-256-GCM) -------------------
# Clé de 32 octets encodée en base64 (urlsafe). Générer avec :
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Si absente : dérivée de DJANGO_SECRET_KEY (uniquement en dev, un avertissement
# est émis). En production cette variable est OBLIGATOIRE.
CHAMP_CHIFFREMENT_CLE=cOUmMJ_pNZkDMf46QKRxG7QN48lwq_xPSrrWp_TRzuw=

# --- JWT ------------------------------------------------------------------
# Algorithme de signature : HS256 (défaut, simple) ou RS256 (recommandé en prod).
JWT_ALGORITHM=HS256
# Pour RS256 uniquement : chemins vers les clés PEM (privée pour signer,
# publique pour vérifier). Générer avec la commande `manage.py generer_cles_jwt`.
JWT_SIGNING_KEY_PATH=
JWT_VERIFYING_KEY_PATH=

# --- CORS -----------------------------------------------------------------
# Origines autorisées du frontend (séparées par des virgules).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- MQTT (réception des scans de carte) ----------------------------------
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC_SCAN=campus/reader/scan
MQTT_USERNAME=
MQTT_PASSWORD=
# Adresse du backend appelée par le listener pour rejouer la logique HTTP (optionnel)

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Établissement (affiché sur les reçus PDF) ----------------------------
ETABLISSEMENT_NOM=École Supérieure Polytechnique — UCAD
ETABLISSEMENT_VILLE=Dakar, Sénégal
