    {
      "name": "Monetique",
      "item": [
        {
          "name": "Solde (etudiant le sien / admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/solde/{{uid}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "solde", "{{uid}}", ""]
            }
          }
        },
        {
          "name": "Historique transactions (filtres)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/transactions/{{uid}}/?type=debit&page=1",
              "host": ["{{base_url}}"],
              "path": ["api", "transactions", "{{uid}}", ""],
              "query": [
                { "key": "type", "value": "debit" },
                { "key": "statut", "value": "valide", "disabled": true },
                { "key": "date_debut", "value": "2025-01-01", "disabled": true },
                { "key": "date_fin", "value": "2026-12-31", "disabled": true },
                { "key": "page", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "Credit / recharge (caissier ou admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uid\": \"{{uid}}\",\n  \"montant\": 50000,\n  \"terminal_id\": \"RECH-01\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/transaction/credit/",
              "host": ["{{base_url}}"],
              "path": ["api", "transaction", "credit", ""]
            }
          }
        },
        {
          "name": "Debit (caissier/admin + SIGNATURE carte)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uid\": \"{{uid}}\",\n  \"terminal_id\": \"RESTO-01\",\n  \"timestamp\": 0,\n  \"nonce\": \"REMPLACER\",\n  \"signature\": \"REMPLACER\",\n  \"montant\": 15000\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/transaction/debit/",
              "host": ["{{base_url}}"],
              "path": ["api", "transaction", "debit", ""]
            },
            "description": "Corps signé requis. Générer avec :\n`python manage.py simuler_scan --uid SC-2025-00001 --terminal RESTO-01`\npuis copier uid/terminal_id/timestamp/nonce/signature dans ce corps et AJOUTER `montant`. Valable 30 s."
          }
        },
        {
          "name": "Bloquer carte (admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
